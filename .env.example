# =====================================================================
# GoldBot - variables de entorno
#
#   cp .env.example .env
#
# NUNCA subas el fichero .env al repositorio (ya esta en .gitignore).
# =====================================================================

# --- General ---
GOLDBOT_LOG_LEVEL=INFO
GOLDBOT_INITIAL_BALANCE=10000

# --- Modo de ejecucion: paper | ccxt | mt5 ---
GOLDBOT_MODE=paper

# SALVAGUARDA PRINCIPAL
# true  = jamas se envia una orden real (recomendado hasta tener semanas
#         de incubacion con resultados consistentes)
# false = se opera con dinero real
GOLDBOT_DRY_RUN=true

# --- Credenciales de exchange (modo ccxt) ---
# En Binance: crea una clave de API con permisos de SPOT unicamente,
# SIN permiso de retirada, y restringida por IP.
GOLDBOT_API_KEY=
GOLDBOT_API_SECRET=

# --- Credenciales de MetaTrader 5 (modo mt5, solo Windows) ---
GOLDBOT_MT5_LOGIN=
GOLDBOT_MT5_PASSWORD=
GOLDBOT_MT5_SERVER=

# --- Telegram (avisos y control remoto) ---
# 1. Habla con @BotFather en Telegram y crea un bot -> te da el token
# 2. Escribe a tu bot y visita:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    para ver tu chat_id
GOLDBOT_TELEGRAM_TOKEN=
GOLDBOT_TELEGRAM_CHAT_ID=
